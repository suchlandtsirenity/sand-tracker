[Unit]
Description=Sand Tracker
After=network.target

[Service]
Type=simple
User=sandtracker
WorkingDirectory=/opt/sand-tracker
Environment=PORT=8787 HOST=127.0.0.1 DB_PATH=/var/lib/sand-tracker/sand.db
ExecStart=/opt/sand-tracker/node/bin/node --experimental-sqlite server.js
Restart=on-failure
StateDirectory=sand-tracker
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
